{
  "name": "motionstudio-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "MotionStudio desktop shell — Electron main process, IPC bridge and packaging (renderer lives in the motionstudio core repo, mounted at core/)",
  "main": "main.js",
  "license": "MIT",
  "author": "Satyr_Astry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satyr-Astry/motionstudio-desktop.git"
  },
  "scripts": {
    "postinstall": "git submodule update --init --recursive",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "check:syntax": "node --check main.js && node --check preload.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "electron": "^40.10.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.satyr.motionstudio",
    "productName": "MotionStudio",
    "copyright": "Copyright © 2026 Satyr_Astry",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "core/app/**/*",
      "!core/app/promo/img/**",
      "!core/.git",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MotionStudio-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MotionStudio",
      "deleteAppDataOnUninstall": false
    }
  }
}
